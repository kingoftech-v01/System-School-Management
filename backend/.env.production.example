# Production Environment Configuration
# Copy this file to .env.production and update with your actual values

# Django Settings
DJANGO_SETTINGS_MODULE=School_System.settings.production
SECRET_KEY=your-very-secure-secret-key-min-50-chars-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,api.your-domain.com

# Database Configuration (PostgreSQL)
DB_NAME=school_management_prod
DB_USER=school_admin
DB_PASSWORD=your-very-secure-db-password-change-this
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-very-secure-redis-password-change-this
REDIS_DB=0
CELERY_BROKER_URL=redis://:your-very-secure-redis-password-change-this@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your-very-secure-redis-password-change-this@redis:6379/0

# Security Settings (Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Email Configuration (Production SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-production-email@your-domain.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=School Management System <noreply@your-domain.com>
EMAIL_FROM_ADDRESS=School Management System <noreply@your-domain.com>

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Gateway - Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-public-key
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Payment Gateway - Braintree (Optional)
BRAINTREE_MERCHANT_ID=your-merchant-id
BRAINTREE_PUBLIC_KEY=your-public-key
BRAINTREE_PRIVATE_KEY=your-private-key
BRAINTREE_ENVIRONMENT=production

# Cloud Storage (AWS S3 for Production)
USE_S3=True
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your-cdn-domain.cloudfront.net

# Social Authentication
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Monitoring (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# Application Settings
SITE_NAME=School Management System
SITE_URL=https://your-domain.com
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# Celery Configuration
CELERY_TASK_ALWAYS_EAGER=False
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_VIEW=django_ratelimit.exceptions.Ratelimited

# CORS (for SPA frontend)
CORS_ORIGIN_WHITELIST=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=True

# Logging
LOG_LEVEL=WARNING
DJANGO_LOG_LEVEL=WARNING

# Flower (Celery Monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=your-very-secure-flower-password

# Superuser Creation (Set to true ONLY on first deployment)
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=your-very-secure-admin-password

# Backup Configuration
ENABLE_AUTO_BACKUP=True
BACKUP_RETENTION_DAYS=30

# Cache Warming
WARM_CACHE=true
